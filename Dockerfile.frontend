# ═══════════════════════════════════════════════════════════════════
#  Dockerfile.frontend  —  Multi-stage production build
#  BUILD CONTEXT: repo root (.)
#  All COPY paths are relative to repo root → frontend/...
# ═══════════════════════════════════════════════════════════════════

# ── Stage 1: deps ─────────────────────────────────────────────────
FROM node:20-alpine AS deps

RUN apk add --no-cache libc6-compat
WORKDIR /app

# context = repo root, so paths are frontend/...
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --frozen-lockfile --ignore-scripts


# ── Stage 2: builder ──────────────────────────────────────────────
FROM node:20-alpine AS builder

ARG NEXT_PUBLIC_API_URL=/api
ARG BUILD_DATE=unknown

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm run build


# ── Stage 3: runtime (standalone output — ~200MB image) ───────────
FROM node:20-alpine AS runtime

ARG BUILD_DATE=unknown
ARG GIT_SHA=unknown

LABEL org.opencontainers.image.title="VoiceRAG Frontend"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_SHA}"

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

COPY --from=builder --chown=nextjs:nodejs /app/public          ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static    ./.next/static

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD wget -qO- http://localhost:3000 || exit 1

CMD ["node", "server.js"]
